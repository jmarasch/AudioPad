<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-android</TargetFramework>
    <!-- Android 15 (API 35) minimum -->
    <SupportedOSPlatformVersion>35</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ApplicationId>com.newterrastudios.audiopad</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0.0</ApplicationDisplayVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
    <!-- Debug builds default to Fast Deployment, which pushes assemblies to the device
         separately from the APK via `dotnet build -t:Run`. That breaks a plain `adb install`
         of the APK (the app aborts at launch, unable to find its assemblies), so embed
         assemblies directly into the APK for a self-contained, sideloadable build. -->
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
  </PropertyGroup>

  <ItemGroup>
    <AndroidResource Include="Icon.png">
      <Link>Resources\drawable\Icon.png</Link>
    </AndroidResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Android" />
    <PackageReference Include="Xamarin.AndroidX.Core.SplashScreen" />
    <PackageReference Include="VideoLAN.LibVLC.Android" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AudioPad.UI\AudioPad.UI.csproj" />
    <ProjectReference Include="..\AudioPad.Audio\AudioPad.Audio.csproj" />
  </ItemGroup>
</Project>
