<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!--If you are willing to use platform-specific APIs, use conditional compilation.
    See https://docs.avaloniaui.net/docs/guides/platforms/platform-specific-code/dotnet for more details.-->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" />
    <!-- Native libVLC binaries: bundled here for Windows only (RID-conditioned so a Linux
         publish doesn't drag in ~1,200 unrelated Windows plugin DLLs). On Linux, libvlc must be
         installed system-wide instead (e.g. `sudo apt install libvlc5`) — see README. -->
    <PackageReference Include="VideoLAN.LibVLC.Windows"
                       Condition="$(RuntimeIdentifier.StartsWith('win')) Or ('$(RuntimeIdentifier)' == '' And $([MSBuild]::IsOSPlatform('Windows')))" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AudioPad.UI\AudioPad.UI.csproj" />
    <ProjectReference Include="..\AudioPad.Audio\AudioPad.Audio.csproj" />
  </ItemGroup>
</Project>
