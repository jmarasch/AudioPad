<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AudioPad.UI.ViewModels"
             xmlns:controls="using:AudioPad.UI.Controls"
             xmlns:conv="using:Avalonia.Data.Converters"
             x:Class="AudioPad.UI.Views.PageOverviewView"
             x:DataType="vm:MainWindowViewModel">
    <UserControl.Styles>
        <Style Selector="Button.armed">
            <Setter Property="Background" Value="#C62828" />
        </Style>
    </UserControl.Styles>

    <Grid Background="{DynamicResource OverviewBackgroundBrush}" RowDefinitions="Auto,*">
        <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*,Auto,Auto" Margin="12">
            <Button Grid.Column="0"
                    Content="{Binding DeleteButtonText}"
                    Classes.armed="{Binding IsDeleteArmed}"
                    Command="{Binding DeleteSelectedPageCommand}"
                    IsEnabled="{Binding SelectedOverviewPage, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />
            <Button Grid.Column="1"
                    Content="Settings"
                    Margin="8,0,0,0"
                    Command="{Binding ConfigureSelectedPageCommand}"
                    IsEnabled="{Binding SelectedOverviewPage, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />
            <Button Grid.Column="3" Content="+ Add Page" Command="{Binding AddPageCommand}" Margin="0,0,8,0" />
            <Button Grid.Column="4" Content="Close" Command="{Binding CloseOverviewCommand}" />
        </Grid>

        <ListBox Grid.Row="1"
                 ItemsSource="{Binding Pages}"
                 SelectedItem="{Binding SelectedOverviewPage}"
                 Margin="12">
            <!-- A single vertical column: pages are an ordered sequence, and a list makes that
                 order — and where a dragged page will land — unambiguous in a way a reflowing
                 grid does not. -->
            <ListBox.ItemTemplate>
                <DataTemplate DataType="vm:PageViewModel">
                    <controls:PageTile Margin="4" HorizontalAlignment="Stretch" />
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.Styles>
                <Style Selector="ListBoxItem">
                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                </Style>
            </ListBox.Styles>
        </ListBox>
    </Grid>
</UserControl>
