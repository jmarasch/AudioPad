<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AudioPad.UI.ViewModels"
             xmlns:controls="using:AudioPad.UI.Controls"
             xmlns:views="using:AudioPad.UI.Views"
             xmlns:conv="using:Avalonia.Data.Converters"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="AudioPad.UI.Views.MainView"
             x:DataType="vm:MainWindowViewModel">
    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <Panel>
        <!-- Pinch in to zoom out to the page overview, pinch out to come back — the gesture the
             zoomed-out/zoomed-in relationship already implies. Two-fingered, so it can't be
             confused with the Carousel's one-finger swipe or a pad's hold-drag. -->
        <Button Content="&lt;" HorizontalAlignment="Left" VerticalAlignment="Center" Command="{Binding PreviousPageCommand}" ZIndex="1" />
        <Button Content="&gt;" HorizontalAlignment="Right" VerticalAlignment="Center" Command="{Binding NextPageCommand}" ZIndex="1" />
        <Button Content="Pages" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,40,0" Command="{Binding OpenPageOverviewCommand}" ZIndex="1" />

        <!-- CarouselItems pads Pages with a clone of the last page at index 0 and a clone of the
             first page at the end. Swiping/advancing one step past either real end lands on a
             clone; MainView.axaml.cs then silently snaps back to the matching real index (see
             OnCarouselSelectionChanged) — the illusion of a seamless, endless carousel. -->
        <Carousel x:Name="PageCarousel"
                  ItemsSource="{Binding CarouselItems}"
                  SelectedIndex="{Binding SelectedCarouselIndex}"
                  IsSwipeEnabled="True">
            <Carousel.PageTransition>
                <PageSlide Duration="0:0:0.25" Orientation="Horizontal" />
            </Carousel.PageTransition>
            <Carousel.ItemTemplate>
                <DataTemplate DataType="vm:CarouselSlot">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Background="{Binding Page.ThemeBrush}" Padding="12">
                            <TextBlock Text="{Binding Page.Title}" HorizontalAlignment="Center" FontSize="20" FontWeight="Bold" />
                        </Border>

                        <!-- DataContext drops to the PageViewModel here so everything below binds to
                             the page itself — including the pad grid's owner lookup, which resolves
                             the items control's DataContext when a drag starts.
                             Rows/Columns are per-page and user-configurable; UniformGrid picks them
                             up so resizing the grid is just changing those numbers. -->
                        <ItemsControl DataContext="{Binding Page}" ItemsSource="{Binding Pads}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="{Binding Rows}" Columns="{Binding Columns}" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:PadViewModel">
                                    <controls:PadButton Margin="4" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </DataTemplate>
            </Carousel.ItemTemplate>
        </Carousel>

        <!-- Shown as an in-place overlay rather than a separate Window: Avalonia's Window/ShowDialog
             needs an owner Window, which doesn't meaningfully exist under Android's single-view
             lifetime. An overlay works identically on Desktop and Android. -->
        <ContentControl IsVisible="{Binding ActiveConfig, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
            <views:PadConfigView DataContext="{Binding ActiveConfig}" />
        </ContentControl>

        <!-- The zoomed-out page manager. Inherits this view's DataContext, since it binds the
             MainWindowViewModel's page collection and commands directly. -->
        <ContentControl IsVisible="{Binding IsPageOverviewOpen}" ZIndex="2">
            <views:PageOverviewView />
        </ContentControl>

        <!-- Above the overview: it's opened from the overview's Settings button. -->
        <ContentControl IsVisible="{Binding ActivePageConfig, Converter={x:Static conv:ObjectConverters.IsNotNull}}" ZIndex="3">
            <views:PageConfigView DataContext="{Binding ActivePageConfig}" />
        </ContentControl>
    </Panel>
</UserControl>
