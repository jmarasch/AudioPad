<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AudioPad.UI.ViewModels"
             x:Class="AudioPad.UI.Controls.PageTile"
             x:DataType="vm:PageViewModel">
    <!-- A full-width row rather than a card: the overview is an ordered list, and a row makes both
         the sequence and a drag's landing position unambiguous. -->
    <Border x:Name="RootBorder"
            Background="{Binding ThemeBrush}"
            HorizontalAlignment="Stretch"
            MinHeight="72"
            CornerRadius="8"
            Padding="16,12"
            DoubleTapped="OnDoubleTapped">
        <Grid ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0"
                       Text="{Binding Title}"
                       FontSize="18"
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Column="1" VerticalAlignment="Center" Opacity="0.8">
                <Run Text="{Binding Rows}" /><Run Text="&#215;" /><Run Text="{Binding Columns}" />
            </TextBlock>
        </Grid>
    </Border>
</UserControl>
